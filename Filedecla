pipeline{

agent any 

tools{
maven 'maven3.9.9'
}

stages{
stage('Github'){
steps{
git branch: 'docker', credentialsId: '563499a6-b9cf-47ed-abda-6f2ad570b390', url: 'https://github.com/vemainno/java-app-docker.git'
}
}
stage('Maven clean'){
steps{
sh "mvn clean package"
}
}
stage('docker build'){
steps{
sh "docker build -t vemana09/java-web-dec:${BUILD_NUMBER} ."
}
}
stage('Docker login & push'){
steps{
withCredentials([string(credentialsId: 'd454ce5a-9b41-4bc7-9c82-521b9a681953', variable: 'docker_cred')]) {
sh "docker login -u vemana09 -p ${docker_cred}"
}
sh "docker push vemana09/java-web-dec:${BUILD_NUMBER}"
}
}
stage('Deploy'){
steps{
sshagent(['AWS_Cred']) {
sh "ssh -o StrictHostKeyChecking=no ubuntu@13.201.78.111 docker rm -f java-web* || true"
}
}
}
}//stages closing
}//pipeline closing
